# Copiar a .env en la raíz del repositorio y completar los valores reales.

DJANGO_SECRET_KEY=cambiar-por-una-clave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Producción (Render + Supabase). En local dejar vacío para usar SQLite.
DATABASE_URL=
# Ejemplo: postgres://usuario:password@host:6543/postgres

# Cloudinary (opcional en desarrollo; vacío = archivos locales en /media/)
CLOUDINARY_URL=
# Ejemplo: cloudinary://api_key:api_secret@cloud_name
